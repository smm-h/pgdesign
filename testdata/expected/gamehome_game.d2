direction: down
currency_transaction_type: {
  shape: rectangle
  label: "<<enum>>\ncurrency_transaction_type\nearn\nspend\nrefund\ngrant\nrevoke"
  style.fill: "#f3e8fd"
}
experiment_status: {
  shape: rectangle
  label: "<<enum>>\nexperiment_status\ndraft\nactive\npaused\ncompleted"
  style.fill: "#f3e8fd"
}
friendship_status: {
  shape: rectangle
  label: "<<enum>>\nfriendship_status\npending\naccepted\nblocked"
  style.fill: "#f3e8fd"
}
generation_status: {
  shape: rectangle
  label: "<<enum>>\ngeneration_status\npending\nrunning\ncompleted\nfailed"
  style.fill: "#f3e8fd"
}
moderation_action_type: {
  shape: rectangle
  label: "<<enum>>\nmoderation_action_type\nwarn\nmute\nban\nunban\ndelete_content"
  style.fill: "#f3e8fd"
}
notification_type: {
  shape: rectangle
  label: "<<enum>>\nnotification_type\nfriend_request\ngame_like\nachievement\nmoderation\nsystem"
  style.fill: "#f3e8fd"
}
report_status: {
  shape: rectangle
  label: "<<enum>>\nreport_status\nopen\nreviewing\nresolved\ndismissed"
  style.fill: "#f3e8fd"
}
report_target_type: {
  shape: rectangle
  label: "<<enum>>\nreport_target_type\nplayer\ngame\ncomment\nchat_message"
  style.fill: "#f3e8fd"
}
server_status: {
  shape: rectangle
  label: "<<enum>>\nserver_status\nstarting\nready\ndraining\nstopped"
  style.fill: "#f3e8fd"
}
server_type: {
  shape: rectangle
  label: "<<enum>>\nserver_type\nbeta\nstable"
  style.fill: "#f3e8fd"
}
session_role: {
  shape: rectangle
  label: "<<enum>>\nsession_role\nhost\nplayer\nspectator"
  style.fill: "#f3e8fd"
}
session_status: {
  shape: rectangle
  label: "<<enum>>\nsession_status\nwaiting\nactive\nfinished"
  style.fill: "#f3e8fd"
}
achievement_def: {
  shape: sql_table
  tooltip: "Achievement templates with criteria. Defines what achievements exist."
  id: uuid {constraint: primary_key}
  name: text {constraint: unique}
  description: text
  icon: text {constraint: nullable}
  criteria: jsonb
  created_at: timestamptz
}
experiment: {
  shape: sql_table
  tooltip: "A/B experiments with variant definitions and allocation percentage."
  id: uuid {constraint: primary_key}
  name: text {constraint: unique}
  description: text {constraint: nullable}
  variants: jsonb
  status: experiment_status
  allocation_pct: int4
  created_at: timestamptz
}
players: {
  shape: sql_table
  tooltip: "Game-layer player identity. Links to auth.users via auth_id; anonymous players have auth_id NULL and is_anonymous true."
  id: uuid {constraint: primary_key}
  auth_id: text {constraint: [foreign_key; unique; nullable]}
  name: text {constraint: idx}
  display_name: text
  is_anonymous: bool
  created_at: timestamptz
  is_ai: bool {constraint: idx}
  ai_model: text {constraint: nullable}
}
players_checks: {
  shape: page
  label: "CHECK\nck_players_ai_model_consistency: (is_ai = true AND ai_model IS NOT NULL) OR (is_ai = false AND ai_model IS NULL)"
  style.fill: "#fff8dc"
  style.stroke-dash: 3
}
players -- players_checks: {style.stroke-dash: 3}
server_registry: {
  shape: sql_table
  tooltip: "Game server fleet registry. Servers register on startup and heartbeat periodically. Used for room routing and load balancing."
  id: text {constraint: primary_key}
  host: text
  port: int4
  version: text
  server_type: server_type {constraint: idx}
  status: server_status {constraint: idx}
  max_sessions: int4
  active_sessions: int4
  last_heartbeat: timestamptz
  registered_at: timestamptz
}
api_keys: {
  shape: sql_table
  tooltip: "API keys for AI agent and service authentication. Keys are hashed; the plaintext is shown only once at creation."
  id: uuid {constraint: primary_key}
  player_id: uuid {constraint: [foreign_key; idx]}
  key_hash: text {constraint: unique}
  name: text
  scopes: jsonb
  created_at: timestamptz
  last_used_at: timestamptz {constraint: nullable}
  revoked_at: timestamptz {constraint: nullable}
}
chat_messages: {
  shape: sql_table
  tooltip: "Player chat messages, partitioned by month. Retention: 90 days (drop old partitions via cron)."
  id: uuid {constraint: primary_key}
  sender_id: uuid {constraint: [foreign_key; idx]}
  channel: text {constraint: idx}
  body: text
  metadata: jsonb {constraint: nullable}
  sent_at: timestamptz {constraint: primary_key}
}
currency_balance: {
  shape: sql_table
  tooltip: "Current virtual currency balance per player. Single row per player."
  player_id: uuid {constraint: [primary_key; foreign_key]}
  balance: int8
  updated_at: timestamptz
}
currency_transaction: {
  shape: sql_table
  tooltip: "Immutable ledger of virtual currency transactions."
  id: uuid {constraint: primary_key}
  player_id: uuid {constraint: [foreign_key; idx]}
  amount: int8
  type: currency_transaction_type {constraint: idx}
  reason: text
  reference_type: text {constraint: nullable}
  reference_id: uuid {constraint: nullable}
  created_at: timestamptz {constraint: idx}
}
experiment_assignment: {
  shape: sql_table
  tooltip: "Tracks which variant a player is assigned to in an experiment."
  experiment_id: uuid {constraint: [primary_key; foreign_key]}
  player_id: uuid {constraint: [primary_key; foreign_key]}
  variant: text
  assigned_at: timestamptz
}
follow: {
  shape: sql_table
  tooltip: "Player-to-player follows. Composite PK prevents duplicate follows."
  follower_id: uuid {constraint: [primary_key; foreign_key]}
  followed_id: uuid {constraint: [primary_key; foreign_key]}
  created_at: timestamptz
}
follow_checks: {
  shape: page
  label: "CHECK\nck_follow_no_self: follower_id <> followed_id"
  style.fill: "#fff8dc"
  style.stroke-dash: 3
}
follow -- follow_checks: {style.stroke-dash: 3}
friendships: {
  shape: sql_table
  tooltip: "Bidirectional friend relationships. player_a < player_b enforces canonical ordering to prevent duplicates."
  id: uuid {constraint: primary_key}
  player_a: uuid {constraint: [foreign_key; unique]}
  player_b: uuid {constraint: [foreign_key; unique]}
  status: friendship_status
  initiated_by: uuid {constraint: [foreign_key; idx]}
  created_at: timestamptz
  updated_at: timestamptz
}
friendships_checks: {
  shape: page
  label: "CHECK\nck_friendships_no_self: player_a <> player_b\nck_friendships_ordered: player_a < player_b"
  style.fill: "#fff8dc"
  style.stroke-dash: 3
}
friendships -- friendships_checks: {style.stroke-dash: 3}
game_catalog: {
  shape: sql_table
  tooltip: "Game metadata registry. Game bundles live on filesystem; this stores discovery metadata only."
  id: uuid {constraint: primary_key}
  title: text
  description: text {constraint: nullable}
  tags: jsonb {constraint: idx}
  creator: uuid {constraint: [foreign_key; idx; nullable]}
  ai_generated: bool
  created_at: timestamptz {constraint: idx}
  generation_model: text {constraint: nullable}
  generation_prompt: text {constraint: nullable}
}
game_catalog_checks: {
  shape: page
  label: "CHECK\nck_game_catalog_generation_consistency: (ai_generated = true AND generation_model IS NOT NULL) OR (ai_generated = false AND generation_model IS NULL AND generation_prompt IS NULL)"
  style.fill: "#fff8dc"
  style.stroke-dash: 3
}
game_catalog -- game_catalog_checks: {style.stroke-dash: 3}
notification: {
  shape: sql_table
  tooltip: "Player notifications for friend requests, likes, achievements, moderation, and system events."
  id: uuid {constraint: primary_key}
  player_id: uuid {constraint: [foreign_key; idx]}
  type: notification_type
  title: text
  body: text
  data: jsonb {constraint: nullable}
  read: bool
  created_at: timestamptz {constraint: idx}
}
player_age_verification: {
  shape: sql_table
  tooltip: "Age verification and parental consent state. is_minor is true when age < 16. Minors require parental consent before enabling social features."
  player_id: uuid {constraint: [primary_key; foreign_key]}
  birth_date: date
  is_minor: bool
  parental_consent_required: bool
  parental_consent_given: bool
  parent_email: text {constraint: nullable}
  consent_token: text {constraint: [idx; nullable]}
  consent_token_expires_at: timestamptz {constraint: nullable}
  consent_given_at: timestamptz {constraint: nullable}
  created_at: timestamptz
}
player_privacy_settings: {
  shape: sql_table
  tooltip: "Per-player privacy controls. Created at registration with all social features disabled (privacy-by-default)."
  player_id: uuid {constraint: [primary_key; foreign_key]}
  public_profile: bool
  chat_enabled: bool
  friends_enabled: bool
  leaderboard_visible: bool
  updated_at: timestamptz
}
player_profile: {
  shape: sql_table
  tooltip: "Extended player profile with bio, avatar, and progression data."
  player_id: uuid {constraint: [primary_key; foreign_key]}
  bio: text {constraint: nullable}
  avatar_url: text {constraint: nullable}
  status_text: text {constraint: nullable}
  level: int4
  xp: int8
}
player_setting: {
  shape: sql_table
  tooltip: "Key-value player settings. Composite PK on (player_id, key)."
  player_id: uuid {constraint: [primary_key; foreign_key]}
  key: text {constraint: primary_key}
  value: text
}
report: {
  shape: sql_table
  tooltip: "Player-submitted reports against other players, games, comments, or chat messages."
  id: uuid {constraint: primary_key}
  reporter_id: uuid {constraint: [foreign_key; idx]}
  target_type: report_target_type {constraint: idx}
  target_id: uuid {constraint: idx}
  reason: text
  status: report_status {constraint: idx}
  created_at: timestamptz
}
achievement: {
  shape: sql_table
  tooltip: "Earned achievements per player. Composite PK prevents duplicate awards."
  player_id: uuid {constraint: [primary_key; foreign_key]}
  achievement_def_id: uuid {constraint: [primary_key; foreign_key]}
  game_id: uuid {constraint: [foreign_key; idx; nullable]}
  earned_at: timestamptz
}
game_comment: {
  shape: sql_table
  tooltip: "Player comments on games."
  id: uuid {constraint: primary_key}
  game_id: uuid {constraint: [foreign_key; idx]}
  player_id: uuid {constraint: [foreign_key; idx]}
  body: text
  created_at: timestamptz {constraint: idx}
}
game_fork: {
  shape: sql_table
  tooltip: "Tracks when a game is forked (remixed) from another. Links parent and child games."
  id: uuid {constraint: primary_key}
  parent_game_id: uuid {constraint: [foreign_key; idx]}
  child_game_id: uuid {constraint: [foreign_key; idx]}
  forked_by: uuid {constraint: [foreign_key; idx]}
  created_at: timestamptz
}
game_like: {
  shape: sql_table
  tooltip: "Player likes on games. Composite PK prevents duplicate likes."
  player_id: uuid {constraint: [primary_key; foreign_key]}
  game_id: uuid {constraint: [primary_key; foreign_key]}
  created_at: timestamptz
}
game_version: {
  shape: sql_table
  tooltip: "Versioned game bundles. Each game can have multiple published versions."
  id: uuid {constraint: primary_key}
  game_id: uuid {constraint: [foreign_key; idx]}
  version_number: text
  bundle_path: text
  bundle_size: int8
  changelog: text {constraint: nullable}
  created_at: timestamptz {constraint: idx}
}
generation_job: {
  shape: sql_table
  tooltip: "AI game generation jobs. Tracks prompt, model, cost, and progress."
  id: uuid {constraint: primary_key}
  requested_by: uuid {constraint: [foreign_key; idx]}
  game_id: uuid {constraint: [foreign_key; idx; nullable]}
  prompt: text
  status: generation_status {constraint: idx}
  model: text
  cost_cents: int4
  progress: int4
  error_message: text {constraint: nullable}
  created_at: timestamptz {constraint: idx}
  completed_at: timestamptz {constraint: nullable}
}
platform_leaderboards: {
  shape: sql_table
  tooltip: "Cross-game leaderboard entries. Each row is a score submission for a specific game."
  id: uuid {constraint: primary_key}
  game_id: uuid {constraint: [foreign_key; idx]}
  player_id: uuid {constraint: [foreign_key; idx]}
  score: int8 {constraint: idx}
  metadata: jsonb {constraint: nullable}
  achieved_at: timestamptz {constraint: idx}
}
session: {
  shape: sql_table
  tooltip: "Multiplayer game sessions (lobbies). Tracks room code, player cap, and lifecycle."
  id: uuid {constraint: primary_key}
  game_id: uuid {constraint: [foreign_key; idx]}
  status: session_status {constraint: idx}
  room_code: text {constraint: idx}
  max_players: int4
  config: jsonb
  result: jsonb {constraint: nullable}
  created_at: timestamptz
  started_at: timestamptz {constraint: nullable}
  ended_at: timestamptz {constraint: nullable}
  server_id: text {constraint: [foreign_key; idx; nullable]}
}
moderation_action: {
  shape: sql_table
  tooltip: "Actions taken by moderators in response to reports."
  id: uuid {constraint: primary_key}
  report_id: uuid {constraint: [foreign_key; idx]}
  action_type: moderation_action_type
  moderator_note: text {constraint: nullable}
  acted_at: timestamptz
}
game_play: {
  shape: sql_table
  tooltip: "Individual play sessions. Tracks when a player plays a game, duration, and score."
  id: uuid {constraint: primary_key}
  game_id: uuid {constraint: [foreign_key; idx]}
  player_id: uuid {constraint: [foreign_key; idx]}
  version_id: uuid {constraint: [foreign_key; idx; nullable]}
  duration_seconds: int4 {constraint: nullable}
  completed: bool
  score: int8 {constraint: nullable}
  created_at: timestamptz {constraint: idx}
}
action_log: {
  shape: sql_table
  tooltip: "Append-only game action log for replay and reconnection. Each action has a monotonically increasing sequence number within its session."
  id: uuid {constraint: primary_key}
  session_id: uuid {constraint: [foreign_key; idx]}
  player_id: uuid {constraint: [foreign_key; idx]}
  action: jsonb
  sequence_num: int8 {constraint: idx}
  created_at: timestamptz
}
session_participant: {
  shape: sql_table
  tooltip: "Players in a game session with their role."
  session_id: uuid {constraint: [primary_key; foreign_key]}
  player_id: uuid {constraint: [primary_key; foreign_key]}
  role: session_role
  joined_at: timestamptz
}
state_snapshot: {
  shape: sql_table
  tooltip: "Periodic game state snapshots for fast reconnection. Load latest snapshot, replay actions from its sequence_num forward."
  id: uuid {constraint: primary_key}
  session_id: uuid {constraint: [foreign_key; idx]}
  state: jsonb
  action_sequence_num: int8 {constraint: idx}
  created_at: timestamptz
}

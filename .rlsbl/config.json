{
  "changelog_format_version_enforced": true,
  "targets": [
    "go",
    {
      "name": "npm",
      "path": "npm/"
    },
    {
      "name": "pypi",
      "path": "pypi/"
    }
  ],
  "pipelines": {
    "go": {
      "type": "go",
      "target": "go",
      "local": true,
      "install_paths": [
        "./cmd/pgdesign"
      ],
      "artifact": "binary"
    },
    "npm": {
      "type": "npm",
      "target": "npm",
      "local": false,
      "provenance": true
    },
    "pypi": {
      "type": "pypi",
      "target": "pypi",
      "local": false
    }
  },
  "publish_mode": "ci",
  "push_timeout": 120,
  "batch_limits": {
    "exclusions": []
  }
}
